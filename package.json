{
  "name": "midi-music-generator",
  "version": "0.1.0",
  "description": "Rule-based generator for instrumental music in nineteen genres \u2014 form, harmony, melody, bass, comping and drums, rendered to MIDI and to Strudel",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "gen": "tsx src/cli.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "audit": "tsx src/audit.ts",
    "check": "tsx src/check-notation.ts",
    "moods": "tsx src/mood-report.ts",
    "strictness": "tsx src/strictness-report.ts",
    "hook": "tsx src/hook-report.ts",
    "genres": "tsx src/genre-check.ts",
    "rules": "tsx src/rules-doc.ts",
    "rules:check": "tsx src/rules-doc.ts --check",
    "concert": "tsx src/concert-check.ts",
    "chaos": "tsx src/chaos-check.ts",
    "stage": "tsx src/stage-check.ts",
    "verify": "npm run typecheck && npm run rules:check && npm run genres && npm run check && npm run concert && npm run chaos && npm run stage && npm run audit 40 && npm run ensemble 40",
    "ensemble": "tsx src/ensemble-report.ts",
    "score": "tsx src/score.ts",
    "tune": "tsx src/tune-lab.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "@types/three": "^0.185.1",
    "three": "^0.185.1"
  }
}
