{
  "name": "midi-music-generator",
  "version": "0.1.0",
  "description": "Rule-based generator for Finnish iskelmä (instrumental) — renders to MIDI and Strudel",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "gen": "tsx src/cli.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "audit": "tsx src/audit.ts",
    "check": "tsx src/check-notation.ts",
    "moods": "tsx src/mood-report.ts",
    "strictness": "tsx src/strictness-report.ts",
    "genres": "tsx src/genre-check.ts",
    "verify": "npm run typecheck && npm run genres && npm run check && npm run audit 40"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0"
  }
}
